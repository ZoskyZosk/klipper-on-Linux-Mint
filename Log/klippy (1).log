[heater_fan extruder_fan]
pin = PB15
heater = extruder
heater_temp = 50.0

[fan]
pin = PC6
cycle_time = .08
kick_start_time = .25

[homing_override]
axes = z
set_position_z = 0
gcode = 
	G90
	G0 Z5 F500
	G28 X0 Y0
	G0 X125 Y100 F9000
	G28 Z0
	G0 Z5 F500

[bed_mesh]
speed = 150
horizontal_move_z = 5
mesh_min = 25,35.0
mesh_max = 225.0,220
probe_count = 6,6
algorithm = bicubic
fade_start = 1
fade_end = 10
