sensor_pin = PC0
min_temp = 0
max_temp = 130
control = pid
pid_kp = 241.48
pid_ki = 22.74
pid_kd = 640.95

[probe]
pin = ^PC2
x_offset = 0
y_offset = 25
z_offset = 0
samples = 3
